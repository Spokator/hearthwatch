# Hearthwatch configuration. `install.sh` creates `.env` for you.

# --- Game server (initial values: change them later from the panel) ---
SERVER_NAME=My Valheim Server
# At least 5 characters and must not appear in the server name. Empty = generated.
SERVER_PASSWORD=
WORLD_NAME=Dedicated
# 1 = listed in the in-game server browser
SERVER_PUBLIC=0
# 1 = crossplay (PlayStation, Xbox, Game Pass, Switch)
SERVER_CROSSPLAY=1
# 1 = install ServersideQoL mods (server-side only, console compatible)
SERVERSIDE_QOL=1

# --- Panel ---
PANEL_PORT=8080
# 127.0.0.1 when a reverse proxy (the "https" profile) sits in front of the panel
PANEL_BIND=0.0.0.0
# Address shown to PC players (public IP or domain)
PUBLIC_ADDRESS=
# Default language for the panel and in-game messages: en or fr
HW_LANGUAGE=en
# Domain for automatic HTTPS (docker compose --profile https up -d)
DOMAIN=

# --- Automation (container time zone) ---
TZ=Etc/UTC
# Hour of the daily world archive and of the daily restart that installs updates (-1 = disabled)
BACKUP_HOUR=4
RESTART_HOUR=5
